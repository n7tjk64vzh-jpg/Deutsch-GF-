<script>
{
const $=s=>document.querySelector(s);
const CODE='BKE';
const ic={ea:'<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7" r="4"/><path d="M4 22c0-5 3.6-8 8-8s8 3 8 8z"/></svg>',
pa:'<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="7" r="3.4"/><circle cx="16.5" cy="7" r="3.4"/><path d="M1 21c0-4 3-7 7-7s7 3 7 7zM13 21c.3-2.4-.5-4.6-2-6.2 1.6-.6 3.6-.8 5.5-.8 4 0 6.5 3 6.5 7z"/></svg>'};
document.querySelectorAll('[data-ic]').forEach(t=>t.insertAdjacentHTML('afterbegin',ic[t.dataset.ic]));

/* Lehrkraft-Modus */
const tBtn=$('#tBtn'),dlg=$('#dlg');
const setT=on=>{document.body.classList.toggle('teacher',on);tBtn.setAttribute('aria-pressed',on);tBtn.textContent=on?'Lehrkraft-Modus beenden':'Lehrkraft-Modus'};
tBtn.addEventListener('click',()=>{if(document.body.classList.contains('teacher'))return setT(false);$('#code').value='';$('#err').textContent='';dlg.showModal();$('#code').focus()});
$('#dlgF').addEventListener('submit',e=>{e.preventDefault();if($('#code').value.trim().toUpperCase()===CODE){dlg.close();setT(true)}else $('#err').textContent='Der Code stimmt nicht.'});
$('#dlgX').addEventListener('click',()=>dlg.close());

/* Aufgabe 2 */
const L=[{k:'ein',n:'Einleitung',c:'#9a8a84'},{k:'the',n:'These',c:'#A04A4C'},{k:'arg',n:'Argument',c:'#3E7370'},{k:'bel',n:'Beleg/Beispiel',c:'#C08A3E'},{k:'geg',n:'Gegenargument & Entkräftung',c:'#5A2A31'},{k:'sch',n:'Schluss',c:'#6C5A56'}];
const S=[
['Ich mache gerade mein Praktikum im Seniorenzentrum „Haus am Mühlenbach“ und erlebe jeden Tag, wie erschöpft viele Pflegekräfte sind.','ein','Anlass: persönliche Beobachtung'],
['Deshalb bin ich der Meinung: Pflegekräfte sollten eine Vier-Tage-Woche bei gleichem Lohn bekommen.','the','Signal: „Ich bin der Meinung“'],
['Erstens würden sich die Beschäftigten besser erholen und seltener krank werden.','arg','Argument 1 (Faktenargument)'],
['In unserem Haus fielen allein im Oktober sieben von zwanzig Kolleginnen und Kollegen wegen Krankheit aus.','bel','Beleg zu Argument 1: Zahl'],
['Auch unsere Pflegedienstleitung, Frau Breuer, die seit 25 Jahren in der Pflege arbeitet, sagt: „Ausgeruhte Pflegekräfte machen weniger Fehler.“','bel','Beleg zu Argument 1: Aussage einer Fachperson'],
['Zweitens wird der Beruf dadurch für junge Leute attraktiver.','arg','Argument 2 (Erfahrungsargument)'],
['Meine Mitschülerin Aylin sagt zum Beispiel, sie würde sofort in die Pflege gehen, wenn sie einen Tag mehr frei hätte.','bel','Beispiel zu Argument 2'],
['Drittens ist es einfach fair, wenn Menschen, die sich jeden Tag um andere kümmern, auch selbst Zeit für ihre Familie und ihre Gesundheit haben.','arg','Argument 3 (normatives Argument)'],
['Natürlich kostet eine Vier-Tage-Woche Geld.','geg','Gegenargument'],
['Aber wenn weniger Menschen krank werden oder kündigen, spart das am Ende auch Kosten.','geg','Entkräftung des Gegenarguments'],
['Deshalb fordere ich: Probieren wir die Vier-Tage-Woche wenigstens ein Jahr lang aus!','sch','Schluss: These als Appell wiederholt']];
let pen='the';const mark=S.map(()=>null);
const lab=k=>L.find(x=>x.k===k);
const drawPal=()=>{$('#pal').innerHTML=L.map(l=>`<button class="chip" data-k="${l.k}" aria-pressed="${pen===l.k}" style="border-color:${l.c};color:${l.c};${pen===l.k?'background:'+l.c:''}">${l.n}</button>`).join('')+`<button class="chip" data-k="" aria-pressed="${pen===''}">Radierer</button>`};
const drawTxt=(fb)=>{$('#ltxt').innerHTML=S.map((s,i)=>{const m=mark[i]&&lab(mark[i]);const cls=fb?(mark[i]===s[1]?' ok':' no'):'';
return `<span class="s${cls}" tabindex="0" role="button" data-i="${i}" style="${m?'background:'+m.c+'26':''}"><sup>${i+1}</sup>${s[0]}${m?`<span class="lb" style="background:${m.c}">${m.n}</span>`:''}</span> `}).join('')};
$('#pal').addEventListener('click',e=>{const b=e.target.closest('.chip');if(!b)return;pen=b.dataset.k;drawPal()});
const hit=e=>{const s=e.target.closest('.s');if(!s)return;const i=+s.dataset.i;mark[i]=pen||null;drawTxt();$('#res2').textContent=''};
$('#ltxt').addEventListener('click',hit);
$('#ltxt').addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();hit(e);document.querySelector(`.s[data-i="${e.target.dataset.i}"]`)?.focus()}});
$('#chk2').addEventListener('click',()=>{const r=S.filter((s,i)=>mark[i]===s[1]).length;drawTxt(true);$('#res2').textContent=`${r} von ${S.length} Sätzen richtig markiert.`+(r===S.length?' Stark!':' Rot unterstrichene Sätze noch einmal prüfen.')});
$('#rst2').addEventListener('click',()=>{mark.fill(null);drawTxt();$('#res2').textContent=''});
$('#sol2').addEventListener('click',()=>{S.forEach((s,i)=>mark[i]=s[1]);drawTxt(true);$('#res2').textContent='Lösung eingeblendet.'});
$('#lk2').innerHTML=S.map(s=>`<li><b>${lab(s[1]).n}</b> – ${s[2]}</li>`).join('');
drawPal();drawTxt();

/* Aufgabe 3 */
const T=['Faktenargument','Autoritätsargument','Erfahrungsargument','Normatives Argument','Analogieargument'];
const I=[
['Kinder, die regelmäßig draußen spielen, sind nachweislich seltener erkältet und motorisch geschickter.',0,'Bezieht sich auf überprüfbare Ergebnisse („nachweislich“).'],
['Eine Kinderärztin vom Gesundheitsamt Heinsberg empfiehlt, dass Kinder jeden Tag mindestens eine Stunde an der frischen Luft verbringen.',1,'Beruft sich auf eine Fachperson.'],
['In meinem Praktikum habe ich erlebt, dass die Kinder nach dem Waldtag viel ruhiger und ausgeglichener waren.',2,'Eigenes Erlebnis („habe ich erlebt“).'],
['Jedes Kind hat ein Recht darauf, die Natur kennenzulernen – auch wenn es in der Stadt wohnt.',3,'Beruft sich auf ein Recht bzw. einen Wert.'],
['Genauso wie Erwachsene nach langer Büroarbeit Bewegung brauchen, brauchen Kinder nach dem Basteln Zeit zum Toben.',4,'Vergleich mit einem ähnlichen Fall („Genauso wie …“).'],
['Laut Bildungsgrundsätzen NRW gehören Bewegung und Naturerfahrung zu den zentralen Bildungsbereichen in der Kita.',1,'Beruft sich auf eine Institution bzw. ein offizielles Dokument.'],
['Meine Cousine arbeitet in einem Waldkindergarten und erzählt, dass dort fast nie Streit um Spielzeug entsteht.',2,'Erfahrung einer anderen Person.'],
['Es ist ungerecht, wenn nur Kinder aus Familien mit Garten regelmäßig draußen spielen können.',3,'Wertung „ungerecht“ – es geht um Gerechtigkeit.']];
const sel=I.map(()=>'');
const drawItems=fb=>{$('#items').innerHTML=I.map((it,i)=>{const c=fb&&sel[i]!==''?(+sel[i]===it[1]?' ok':' no'):'';
return `<div class="it${c}"><p><b>${i+1}.</b> ${it[0]}</p><select data-i="${i}" aria-label="Argumenttyp zu Aussage ${i+1}"><option value="">– Typ wählen –</option>${T.map((t,j)=>`<option value="${j}" ${sel[i]===String(j)?'selected':''}>${t}</option>`).join('')}</select><div class="fb">${c===' ok'?'Richtig: ':'Noch nicht. Tipp: '}${it[2]}</div></div>`}).join('')};
$('#items').addEventListener('change',e=>{const s=e.target.closest('select');if(!s)return;sel[+s.dataset.i]=s.value;$('#res3').textContent=''});
$('#chk3').addEventListener('click',()=>{const r=I.filter((it,i)=>+sel[i]===it[1]&&sel[i]!=='').length;drawItems(true);$('#res3').textContent=`${r} von ${I.length} richtig.`});
$('#rst3').addEventListener('click',()=>{sel.fill('');drawItems();$('#res3').textContent=''});
$('#sol3').addEventListener('click',()=>{I.forEach((it,i)=>sel[i]=String(it[1]));drawItems(true);$('#res3').textContent='Lösung eingeblendet.'});
$('#lk3').innerHTML=I.map(it=>`<li><b>${T[it[1]]}</b> – ${it[2]}</li>`).join('');
drawItems();

/* Aufgabe 4 */
const K=[['Jede Kita sollte einen festen Waldtag pro Woche einführen.','These'],
['Denn Bewegung in der Natur stärkt die Gesundheit der Kinder.','Argument'],
['Fachleute für Kindergesundheit betonen, dass Kinder, die viel draußen sind, seltener krank werden.','Beleg'],
['In der Kita „Sonnenblume“ in Hückelhoven sind die Fehltage seit Einführung des Waldtags deutlich gesunken.','Beispiel'],
['Ein Waldtag ist also eine einfache Möglichkeit, Kinder gesünder aufwachsen zu lassen.','Folgerung']];
let ord=[];
const shuffle=()=>{do{ord=K.map((_,i)=>i).sort(()=>Math.random()-.5)}while(ord.every((v,i)=>v===i))};
const right=()=>ord.every((v,i)=>v===i)||ord.join()==='0,1,3,2,4';
const drawOrd=fb=>{$('#ord').innerHTML=ord.map((k,p)=>{const c=fb?(k===p||(right())?' ok':' no'):'';
return `<li class="${c}"><span class="n">${p+1}</span><span class="tx">${K[k][0]} <span class="role">· ${K[k][1]}</span></span><button data-p="${p}" data-d="-1" aria-label="Nach oben" ${p===0?'disabled':''}>↑</button><button data-p="${p}" data-d="1" aria-label="Nach unten" ${p===ord.length-1?'disabled':''}>↓</button></li>`}).join('')};
$('#ord').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const p=+b.dataset.p,q=p+ +b.dataset.d;[ord[p],ord[q]]=[ord[q],ord[p]];drawOrd();$('#res4').textContent='';$(`#ord button[data-p="${q}"][data-d="${b.dataset.d}"]`)?.focus()});
$('#chk4').addEventListener('click',()=>{drawOrd(true);$('#res4').textContent=right()?'Richtig! Die Kette ist logisch aufgebaut.':'Noch nicht ganz. Rot markierte Bausteine stehen an der falschen Stelle.'});
$('#rst4').addEventListener('click',()=>{shuffle();drawOrd();$('#res4').textContent=''});
$('#sol4').addEventListener('click',()=>{ord=K.map((_,i)=>i);drawOrd(true);$('#res4').textContent='Lösung eingeblendet.'});
shuffle();drawOrd();

/* Aufgabe 5 */
const B=['In ihrem Leserbrief „…“ setzt sich … mit … auseinander.','Sie vertritt die These, dass …','Ihr erstes Argument lautet, dass …','Als Beleg führt sie an, dass …','Dies veranschaulicht sie am Beispiel …','Anschließend greift sie das Gegenargument auf, dass …','Sie entkräftet es, indem …','Am Schluss fordert sie …','Insgesamt ist der Text … aufgebaut.'];
$('#bau').innerHTML=B.map((b,i)=>`<button data-i="${i}">${b}</button>`).join('');
const ta=$('#txt');
try{ta.value=localStorage.getItem('arg-txt')||''}catch(e){}
ta.addEventListener('input',()=>{try{localStorage.setItem('arg-txt',ta.value)}catch(e){}});
$('#bau').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const t=B[+b.dataset.i];const p=ta.selectionStart??ta.value.length;const pre=ta.value.slice(0,p),ins=(pre&&!/\s$/.test(pre)?' ':'')+t+' ';ta.value=pre+ins+ta.value.slice(p);ta.focus();ta.selectionStart=ta.selectionEnd=p+ins.length;ta.dispatchEvent(new Event('input'))});
$('#cpy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(ta.value);$('#res5').textContent='Kopiert – du kannst den Text jetzt einfügen.'}catch(e){ta.select();$('#res5').textContent='Text markiert – bitte mit Strg+C kopieren.'}});
}
</script>
