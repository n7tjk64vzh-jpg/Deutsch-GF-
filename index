<title>Argumentation untersuchen</title>
<style>
/* VOICE: ruhig, klar, schulnah – Arbeitsheft statt Werbeseite
   IDEA: ein Arbeitsheft mit Markierstiften: Text farbig markieren, Bausteine ordnen
   PICTURE: der Leserbrief als Markiertext, These–Argument–Beleg als Baustein-Kette
   COLOUR and TYPE: Hausdesign Terrakotta-Beere & Petrol, Honig als Akzent; Century Schoolbook + Calibri
   LAYOUT: Kopfzeile wie BKE-Arbeitsblatt, nummerierte Aufgabenkarten, eine Spalte, Lehrkraft-Modus blendet Lösungen ein */
:root{color-scheme:light dark;
--bg:light-dark(#FBF5EE,#1d1517);--card:light-dark(#fff,#281e21);--ink:light-dark(#2C2320,#f3e9e4);--mut:light-dark(#6C5A56,#c3b0aa);--fai:light-dark(#A08E88,#8f7c77);--line:light-dark(#ECDCD4,#3e3033);
--pr:light-dark(#A04A4C,#d47c7e);--prd:light-dark(#5A2A31,#f1dcd2);--prl:light-dark(#F1DCD2,#45282d);
--pe:light-dark(#3E7370,#7fb5b1);--ped:light-dark(#1F4A48,#dce9e7);--pel:light-dark(#DCE9E7,#1f3a39);
--ho:light-dark(#C08A3E,#dcaa5f);--hol:light-dark(#F7E8CE,#3d3020);
