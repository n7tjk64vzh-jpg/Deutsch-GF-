html{scroll-padding-top:80px;scroll-behavior:smooth}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
.wrap{max-width:980px;margin:0 auto;padding:0 max(4vw,14px)}
