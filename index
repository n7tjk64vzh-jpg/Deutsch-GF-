.bb.t{border-color:var(--pr);background:var(--prl)}.bb.a{border-color:var(--pe);background:var(--pel)}.bb.b{border-color:var(--ho);background:var(--hol)}
.bb:not(:last-child)::after{content:"→";position:absolute;right:-14px;top:50%;transform:translate(50%,-50%);font-size:22px;color:var(--fai)}
