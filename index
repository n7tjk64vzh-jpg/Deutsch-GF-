.s:hover{outline:1px dashed var(--fai)}
.s sup{font-size:11px;font-weight:700;color:var(--fai);margin-right:2px}
.s .lb{font-size:12px;font-weight:700;border-radius:4px;padding:0 5px;margin-left:4px;color:#fff;white-space:nowrap;vertical-align:1px}
.s.ok{box-shadow:inset 0 -3px 0 #3E7370}.s.no{box-shadow:inset 0 -3px 0 #b3261e}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:14px}
.res{font-weight:600;color:var(--ped)}
/* Zuordnen */
.items{display:grid;gap:10px}
.it{display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:10px 16px;align-items:center;border:1px solid var(--line);border-radius:12px;padding:12px 14px;background:var(--bg)}
.it p{margin:0}.it select{min-height:44px;border-radius:10px;border:1.5px solid var(--line);background:var(--card);padding:6px 10px;width:100%}
.it.ok{border-color:var(--pe);background:var(--pel)}.it.no{border-color:#b3261e}
.it .fb{grid-column:1/-1;font-size:15px;color:var(--mut);display:none}.it.no .fb,.it.ok .fb{display:block}
@media(max-width:600px){.it{grid-template-columns:1fr}}
/* Kette */
.ord{list-style:none;padding:0;margin:0;display:grid;gap:8px}
.ord li{display:flex;align-items:center;gap:10px;border:1.5px solid var(--line);border-radius:12px;padding:8px 10px;background:var(--bg)}
.ord li .tx{flex:1}.ord li .n{font:700 17px var(--hf);color:var(--pr);width:24px;text-align:center;flex:none}
.ord li button{min-height:40px;min-width:40px;padding:0;font-size:18px}
.ord li.ok{border-color:var(--pe);background:var(--pel)}.ord li.no{border-color:#b3261e}
.ord .role{font-size:13px;font-weight:700;color:var(--pe);display:none}.teacher .ord .role{display:inline}
/* Schreiben */
.bau{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0}
.bau button{font-size:15px;min-height:40px;background:var(--prl);border-color:transparent;color:var(--prd)}
textarea{width:100%;min-height:200px;border-radius:12px;border:1.5px solid var(--line);background:var(--bg);padding:14px;font-size:16px;line-height:1.6;resize:vertical}
/* Lehrkraft */
.lk{display:none;margin-top:16px;border:2px dashed var(--ho);border-radius:12px;padding:14px 16px;background:var(--hol)}
.lk h4{margin:0 0 6px;font:700 16px var(--bf);color:light-dark(#7a5416,#f0c98a)}.lk p,.lk li{font-size:16px;margin:.3em 0}.lk ul,.lk ol{padding-left:20px;margin:.3em 0}
.teacher .lk{display:block}
.only-t{display:none}.teacher .only-t{display:inline-flex}
.bar{display:none;background:var(--ho);color:#2C2320;font-weight:600;text-align:center;padding:6px 12px;font-size:15px}.teacher .bar{display:block}
dialog{border:0;border-radius:16px;padding:22px;background:var(--card);color:var(--ink);max-width:min(380px,92vw)}
dialog::backdrop{background:rgba(44,35,32,.5)}
dialog input{width:100%;min-height:44px;border-radius:10px;border:1.5px solid var(--line);background:var(--bg);padding:8px 12px;font-size:16px;margin:10px 0}
